{
  "name": "maillist-worker-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:worker": "wrangler dev",
    "dev": "vite build && wrangler dev",
    "build": "vite build && tsc -p tsconfig.worker.json --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.14",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.2",
    "vite": "^7.3.1",
    "vitest": "^3.0.8",
    "wrangler": "^4.67.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "postal-mime": "^2.7.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "sonner": "^2.0.7"
  }
}
